NODE_ENV=production
LOG_LEVEL=info
TZ=UTC

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Least-privilege: Guilds, GuildMembers, GuildMessages, MessageContent (only if chat bridge needs it)
# Invite URL scopes: bot applications.commands
# Bot permissions: View Channels, Send Messages, Embed Links, Attach Files, Manage Roles,
# Manage Channels, Manage Messages, Ban Members, Moderate Members, Read Message History

DATABASE_PATH=./data/bridge.sqlite
# Optional PostgreSQL later: DATABASE_URL=postgres://user:pass@localhost:5432/bridge

CREDENTIALS_KEY=
BACKUP_ENCRYPTION_KEY=
HMAC_SHARED_SECRET=

RCON_TIMEOUT_MS=5000
PLUGIN_API_TIMEOUT_MS=4000
STATUS_INTERVAL_MS=30000
LOG_TAIL_BATCH_MS=2000
PERF_INTERVAL_MS=60000

BOT_HTTP_PORT=3000
DASHBOARD_ENABLED=false
DASHBOARD_PUBLIC_URL=http://localhost:3000
DASHBOARD_SESSION_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Redis Cache (optional but recommended for production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=300

# Message Queue (BullMQ)
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_DB=1

# 2FA for Staff Commands
STAFF_2FA_ENABLED=true
STAFF_2FA_ISSUER=MCBridge

# AI/ML Features
TOXICITY_DETECTION_ENABLED=true
TOXICITY_MODEL_PATH=./models/toxicity
ANOMALY_DETECTION_ENABLED=true
ANOMALY_THRESHOLD=3.0

ERROR_WEBHOOK_URL=
PROM_METRICS_TOKEN=

# Default server (also stored in servers table after seed)
MC_SERVER_NAME=survival
MC_HOST=127.0.0.1
MC_QUERY_PORT=12329
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
PLUGIN_API_URL=http://127.0.0.1:8765
MC_WORLD_PATH=
MC_LOG_PATH=
MC_BACKUP_PATH=./backups

FLOODGATE_PREFIX=.
