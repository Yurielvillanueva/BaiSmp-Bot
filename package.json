{
  "name": "mc-discord-bridge",
  "version": "1.0.0",
  "description": "Production Discord bot and Paper companion for Minecraft 1.21 Java servers",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "service:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-autostart.ps1",
    "service:save": "pm2 save",
    "deploy": "node scripts/deploy-commands.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests scripts --max-warnings=0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.6.0",
    "bullmq": "^5.12.0",
    "chartjs-node-canvas": "^5.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "minecraft-server-util": "^5.4.4",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "rcon-client": "^4.2.5",
    "speakeasy": "^2.0.0",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "jest": "^30.5.2"
  }
}
